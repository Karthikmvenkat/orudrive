{
  "name": "savarigo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=api",
    "typecheck:api": "npm run typecheck --workspace=api",
    "test:api": "npm test --workspace=api",
    "perf:api": "npm run perf:baseline --workspace=api",
    "db:generate": "npm run db:generate --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:deploy": "npm run db:deploy --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "deploy:build": "docker compose --env-file .env.production build",
    "deploy:migrate": "docker compose --env-file .env.production run --rm migrate",
    "deploy:up": "docker compose --env-file .env.production up -d",
    "deploy:down": "docker compose --env-file .env.production down",
    "deploy:status": "docker compose --env-file .env.production ps",
    "deploy:logs": "docker compose --env-file .env.production logs --tail=100 --follow"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true
  }
}
