# Production environment template for the `docker-compose.yml` stack at the
# repository root.
#
#   cp .env.production.example .env.production   # then fill in every value
#   docker compose --env-file .env.production build
#
# Compose interpolates this file; it is never copied into an image and the
# variables are mapped one by one into containers in docker-compose.yml, so what
# is listed here is exactly what reaches each process.
#
# .env.production is git-ignored. Rotate anything that was ever committed.
#
# Generate a secret with:
#   openssl rand -hex 32
# or, for a Postgres password that survives URL encoding inside DATABASE_URL:
#   openssl rand -base64 24 | tr -d '+/='

#------------------------------------------------------------------------------
# Deployment identity
#------------------------------------------------------------------------------

# Public origin of the website, scheme included, no trailing slash. Three things
# derive from it: the browser bundle's API base URL (baked at build time), the
# CORS allow-list and the `Origin` Next.js uses when it rebuilds absolute URLs.
WEB_ORIGIN=https://savarigo.example.com

# DNS name nginx serves TLS for and certbot requests the certificate for. It
# must be the host part of WEB_ORIGIN.
DOMAIN=savarigo.example.com

# Image tags used by `build` and by the deployment workflow. Pin these to a
# release so a rollback is `docker compose up -d` with an older tag.
API_TAG=0.3.0
WEB_TAG=0.1.0

# Image names. The defaults suit `npm run deploy:build` on this host; the CI
# pipeline (.github/workflows/deploy.yml) pushes buildx images to GHCR and sets
# these two on the command line, so the VPS pulls instead of compiling:
#   API_IMAGE=ghcr.io/<owner>/savarigo-api WEB_IMAGE=ghcr.io/<owner>/savarigo-web
# Leave them unset here unless the host should really pull from a registry.
API_IMAGE=
WEB_IMAGE=

#------------------------------------------------------------------------------
# PostgreSQL
#------------------------------------------------------------------------------

POSTGRES_USER=savarigo_prod
POSTGRES_PASSWORD=change-me
POSTGRES_DB=savarigo

# Postgres, the API and the website are published on the host loopback only,
# for curl diagnostics, backup jobs and uptime checks. Nginx reaches them over
# the internal Compose network instead, so nothing here has to be 0.0.0.0.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=4100
WEB_HOST_PORT=3100

#------------------------------------------------------------------------------
# Secrets — all three are required, and the API refuses to boot if a production
# value is shorter than 32 characters or still contains "replace-with".
#------------------------------------------------------------------------------

# Access tokens are deliberately short-lived; the refresh token is what keeps a
# rider signed in, and every refresh rotates it (a replayed token revokes the
# whole chain).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# HMAC key for the OTP and password-reset codes. The code falls back to
# JWT_REFRESH_SECRET when this is unset, but Compose requires it: one secret used
# for two purposes means rotating the refresh key silently invalidates every
# outstanding code.
OTP_SECRET=

#------------------------------------------------------------------------------
# Rate limiting and proxy trust
#------------------------------------------------------------------------------

# Number of reverse-proxy hops whose X-Forwarded-For entry may be believed.
# This stack has exactly one (nginx). Setting it higher lets a client forge its
# address and step around every throttle and audit entry; setting it to 0 makes
# every rider share one bucket and gets the whole datacentre rate-limited.
TRUST_PROXY_HOPS=1
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

#------------------------------------------------------------------------------
# Pricing and payments
#------------------------------------------------------------------------------

BOOKING_TAX_PERCENT=5

# `razorpay` is the only provider implemented. With PAYMENT_PROVIDER=razorpay in
# production, the three key variables below are validated as required.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
# Server-side only. Never exposed to the browser and never prefixed NEXT_PUBLIC.
RAZORPAY_KEY_SECRET=
# Signature secret for POST /api/v1/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=

#------------------------------------------------------------------------------
# Email (SMTP). Left empty, notification delivery logs and continues instead of
# failing the request — bookings and payments still succeed without email.
#------------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SavariGo <no-reply@savarigo.example.com>

#------------------------------------------------------------------------------
# Website runtime
#------------------------------------------------------------------------------

# Sends `Secure` on the httpOnly session cookie. Keep true whenever nginx is
# serving TLS; set false only for an http-only preview box, or login silently
# drops the cookie.
COOKIE_SECURE=true

#------------------------------------------------------------------------------
# TLS termination
#------------------------------------------------------------------------------

# Where certbot keeps the certificate on the host, bind-mounted read-only into
# nginx. Change only for a non-Compose host layout or an ACME staging run.
CERTBOT_CONF_DIR=./deploy/certbot/conf
CERTBOT_WWW_DIR=./deploy/certbot/www
