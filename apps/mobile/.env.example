# ============================================================================
# SavariGo mobile app — environment template
# Copy to `.env.local` (gitignored) and adjust. Every value below is safe to
# commit; nothing secret belongs in this app, because tokens live in
# Keychain/Keystore via expo-secure-store, never in an env var.
# ============================================================================

# ----------------------------------------------------------------------------
# API origin
# ----------------------------------------------------------------------------
# LEAVE THIS UNSET FOR LOCAL DEVELOPMENT.
#
# When unset, the client derives the origin from the Expo dev server URL
# (`Constants.expoConfig.hostUri`), so a phone or simulator on the same Wi-Fi
# reaches the API at whatever LAN IP this machine currently has — no hard-coded
# address, and no rebuild when the DHCP lease changes:
#
#   hostUri "192.168.0.4:8081"  ->  http://192.168.0.4:4100/api/v1
#
# Set it explicitly only when the app must point somewhere else (a tunnel, a
# staging box, or a production build, where EAS injects it from eas.json):
# EXPO_PUBLIC_API_URL="http://192.168.0.4:4100/api/v1"

# Port the development API listens on, used for that derivation. Matches
# `PORT` in apps/api/.env, i.e. the same origin the website talks to.
EXPO_PUBLIC_DEV_API_PORT=4100

# ----------------------------------------------------------------------------
# Media origin
# ----------------------------------------------------------------------------
# Vehicle and category photography is served by the website, not the API: the
# catalogue stores paths such as `/images/vehicles/ola-s1-pro.jpg`, so the app
# has to know the web origin as well as the API origin. Same derivation rule as
# above — leave it unset on a LAN dev build and it becomes the host URI with the
# web port:
#
#   hostUri "192.168.0.4:8081"  ->  http://192.168.0.4:3001
#
# Set it for any build whose images do not live on that host, e.g. a preview
# build pointed at the deployed site:
# EXPO_PUBLIC_MEDIA_URL="https://savarigo.example.com"

# Website dev port used for that derivation. Matches the `--port` the web
# workspace dev server runs on.
EXPO_PUBLIC_DEV_WEB_PORT=3001

# ----------------------------------------------------------------------------
# Payments
# ----------------------------------------------------------------------------
# There is deliberately no gateway variable here. Razorpay Checkout is a
# browser SDK and no native SDK is installed, so a booking made in the app is
# reserved with `paymentStatus: PENDING` and settled on the website or at the
# counter; the app only reads payment history. Card or UPI capture from inside
# the app needs `razorpay-react-native` plus a development client build, which
# is a decision to make before it is written — see README.
