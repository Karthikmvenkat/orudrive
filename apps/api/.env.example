# Copy to apps/api/.env and fill in real values. Never commit .env files.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://savarigo:savarigo@localhost:5432/savarigo?schema=public"

# --- Application ------------------------------------------------------------
NODE_ENV="development"
PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Rate limiting ----------------------------------------------------------
# Hops whose X-Forwarded-For may be believed. Leave at 0 locally: trusting it
# here would let any client name its own address and skip the throttle. Set to 1
# behind nginx (see the repository-root docker-compose.yml).
TRUST_PROXY_HOPS=0
# Requests per IP per THROTTLE_TTL_MS window.
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# --- Auth (Phase 3) ---------------------------------------------------------
JWT_ACCESS_SECRET="replace-with-a-64-character-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-with-a-different-64-character-random-string"
JWT_REFRESH_TTL="30d"
# HMAC key for hashing one-time codes. Falls back to JWT_REFRESH_SECRET.
OTP_SECRET="replace-with-a-64-character-random-string"
# Development only: return the OTP as `devCode` in API responses.
AUTH_DEBUG_OTP="false"

# --- Bookings ---------------------------------------------------------------
# Percentage of the taxable booking subtotal. 0 keeps the current web totals.
BOOKING_TAX_PERCENT=0

# --- Payments (Phase 3) -----------------------------------------------------
# Only gateway keys belong here. Card numbers, CVV and expiry are never
# collected or stored by SavariGo.
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Notifications (Phase 3) ------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SavariGo <no-reply@savarigo.com>"
# Reserved for a future channel: the NotificationChannel enum has WHATSAPP, but
# no code path reads this variable yet, so setting it does nothing.
WHATSAPP_TOKEN=""

# --- Docker Compose (local Postgres) ---------------------------------------
# apps/api/docker-compose.yml interpolates these three to create the database,
# and DATABASE_URL above has to match them.
POSTGRES_USER="savarigo"
POSTGRES_PASSWORD="savarigo"
POSTGRES_DB="savarigo"
# The compose file publishes 5432 on 127.0.0.1 only. Use 0.0.0.0 when another
# machine must reach this database, and treat that as a deliberate exposure.
POSTGRES_HOST_BIND="127.0.0.1"
