# The SavariGo edge: the only container with a port open to the internet.
#
# This file is a *template*. The nginx image runs envsubst over everything in
# /etc/nginx/templates at start-up and writes the result to
# /etc/nginx/conf.d/default.conf, so ${DOMAIN} below comes from the DOMAIN
# environment variable set in docker-compose.yml. nginx's own runtime variables
# ($host, $remote_addr, $request_uri) are not environment variables and are left
# untouched by that substitution.
#
# Two rules explain most of what follows:
#   * /api/v1 belongs to Nest, everything else to Next.js. The browser is
#     configured with NEXT_PUBLIC_API_URL = https://DOMAIN/api/v1, so the API has
#     to be reachable on the same origin — that is what keeps the session
#     cookies first-party and the CORS policy a same-origin no-op.
#   * Response headers are owned by the applications, not by the proxy. Next.js
#     sends CSP, X-Frame-Options and HSTS from `headers()` in
#     apps/web/next.config.ts, and helmet sends the equivalent set for the API
#     (apps/api/src/common/security/http-security.ts). Repeating them here would
#     put two copies of every header on the wire.

upstream savarigo_web {
  server web:3000;
  keepalive 32;
}

upstream savarigo_api {
  server api:4000;
  keepalive 32;
}

server {
  # IPv4 only. `listen [::]:80` would make nginx exit at start-up on Docker's
  # default bridge, which has no IPv6; add it back only once the network does.
  listen 80;
  server_name ${DOMAIN};

  # Certificate renewal goes over plain HTTP, so it must survive the redirect.
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;

  # Hiding the version removes one signal from automated target profiling; it
  # is a small win, but it costs nothing here.
  server_tokens off;

  # Booking and payment payloads are JSON documents of a few kilobytes, and the
  # Razorpay webhook body is signed but still tiny. A generous limit only widens
  # the amount of memory an unauthenticated request can make the box hold.
  client_max_body_size 2m;

  # Rate limiting deliberately happens in the API (@nestjs/throttler, keyed on
  # the client address it derives from X-Forwarded-For with TRUST_PROXY_HOPS=1),
  # not here. Two independent limits mean two ways to get it wrong and two sets
  # of 429 semantics for the frontend to interpret.

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    application/json
    application/javascript
    text/css
    text/html
    text/plain
    image/svg+xml;

  # The OpenAPI description is a map of every route, parameter and DTO in the
  # API. It is served by the API container on the host loopback
  # (`curl http://127.0.0.1:4100/docs`) for the team, and stays off the public
  # origin.
  location = /docs      { return 404; }
  location = /docs-json { return 404; }

  location /api/v1/ {
    proxy_pass http://savarigo_api;
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    proxy_connect_timeout 5s;
    # A booking creation runs one Postgres transaction that reads the calendar,
    # checks coupon rules and writes the reservation; a quote can be revalidated
    # twice in the same request. Cutting that off at 10s would show the rider an
    # error while the booking may already be committed.
    proxy_read_timeout  60s;
    proxy_send_timeout  60s;
  }

  location / {
    proxy_pass http://savarigo_web;
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;
  }
}
